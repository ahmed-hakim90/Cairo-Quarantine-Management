rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function activeAdmin() {
      return signedIn() &&
        profile().data.active == true &&
        (profile().data.role == "super_admin" ||
          profile().data.role == "governorate_admin" ||
          profile().data.role == "office_admin" ||
          profile().data.role == "office_user");
    }

    function governorateAdminFor(officeId) {
      return activeAdmin() &&
        profile().data.role == "governorate_admin" &&
        officeId in profile().data.allowedOfficeIds;
    }

    function officeScopedRead(officeId) {
      return superAdmin() ||
        governorateAdminFor(officeId) ||
        officeAdminFor(officeId) ||
        officeUserFor(officeId);
    }

    function superAdmin() {
      return activeAdmin() && profile().data.role == "super_admin";
    }

    function officeUserFor(officeId) {
      return activeAdmin() &&
        profile().data.role == "office_user" &&
        profile().data.officeId == officeId;
    }

    function officeAdminFor(officeId) {
      return activeAdmin() &&
        profile().data.role == "office_admin" &&
        officeId in profile().data.allowedOfficeIds;
    }

    match /offices/{officeId} {
      allow read: if activeAdmin();
      allow write: if superAdmin();
    }

    match /vaccines/{vaccineId} {
      allow read, write: if superAdmin();
    }

    match /destination_countries/{countryId} {
      allow read, write: if superAdmin();
    }

    match /messageTemplates/{templateId} {
      allow read: if activeAdmin();
      allow write: if superAdmin();
    }

    match /users/{uid} {
      allow read: if superAdmin() || (signedIn() && request.auth.uid == uid);
      allow write: if superAdmin();
    }

    match /requests/{requestId} {
      allow read: if officeScopedRead(resource.data.officeId);
      allow update: if superAdmin() || (
        (officeUserFor(resource.data.officeId) ||
          officeAdminFor(resource.data.officeId)) &&
        request.resource.data.officeId == resource.data.officeId &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "status",
          "notes",
          "lastWhatsappAt",
          "updatedAt"
        ])
      );
      allow create: if false;
      allow delete: if superAdmin();
    }

    match /activityLogs/{logId} {
      allow read, write: if false;
    }

    match /today_queue/{ticketId} {
      allow read: if officeScopedRead(resource.data.officeId);
      allow write: if false;
    }

    match /daily_stats/{statId} {
      allow read: if officeScopedRead(resource.data.officeId);
      allow write: if false;
    }

    match /booking_day_stats/{statId} {
      allow read, write: if false;
    }

    match /booking_duplicates/{dupId} {
      allow read, write: if false;
    }

    match /daily_request_stats/{statId} {
      allow read, write: if false;
    }

    match /rate_limits/{limitId} {
      allow read, write: if false;
    }

    match /settings/{docId} {
      allow read, write: if false;
    }

    match /queue_watches/{watchId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
