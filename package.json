{
  "name": "cairo-portal",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "seed:offices": "node --env-file=.env.local scripts/seed-firestore-offices.mjs",
    "seed:traveler-states": "node --env-file=.env.local scripts/seed-firestore-traveler-states.mjs",
    "seed:vaccines": "node --env-file=.env.local scripts/seed-firestore-vaccines.mjs",
    "setup:production": "node scripts/setup-production.mjs",
    "deploy:firestore": "node scripts/deploy-firestore.mjs",
    "admin:create-profile": "node --env-file=.env.local scripts/create-admin-profile.mjs",
    "backfill:booking-day-stats": "node --env-file=.env.local scripts/backfill-booking-day-stats.mjs",
    "load-test:bookings": "npx tsx --env-file=.env.local scripts/load-test-bookings.ts",
    "handover:docx": ".venv-handover/bin/python scripts/build-handover-docx.py",
